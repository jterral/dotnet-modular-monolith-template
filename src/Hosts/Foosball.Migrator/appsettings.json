{
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning",
        "Microsoft.Hosting.Lifetime": "Information",
        "System": "Warning"
      }
    },
    "Enrich": ["FromLogContext"],
    "Properties": {
      "ApplicationName": "Foosball.Migrator"
    }
  },
  "ConnectionStrings": {
    "Foosball": "__SQLITE_DB_PATH__"
  }
}
